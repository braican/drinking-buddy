{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drinking-buddy",
  "compatibility_date": "2026-11-20",
  // Provides node:crypto and Buffer, used by the auth cookie and menu image upload.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // Secrets (SUPABASE_URL, SUPABASE_SERVICE_KEY, ANTHROPIC_API_KEY, UNTAPPD_ACCESS_TOKEN,
  // APP_PASSWORD) are set with `wrangler secret put` or in the dashboard, not here.
}
